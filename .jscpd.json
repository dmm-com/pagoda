{
  "minTokens": 100,
  "minLines": 20,
  "format": ["javascript", "typescript", "tsx", "python"],
  "ignore": [
    "**/migrations/**",
    "**/node_modules/**",
    "apiclient/**",
    "frontend/src/apiclient/autogenerated/**",
    "**/dist/**",
    "**/build/**"
  ],
  "reporters": ["json"],
  "output": ".cache/debt/jscpd",
  "threshold": 100
}
